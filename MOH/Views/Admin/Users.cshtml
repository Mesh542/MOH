@{
    ViewData["Title"] = "Users";
}

@model List<User>

<div class="text-center">
    <h1 class="display-4">Users</h1>

    <table class="table table-striped table-bordered table-hover mt-4">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Surname</th>
                <th>Age</th>
                <th>Gender</th>
                <th>User Role</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@(item.Name ?? "-")</td>
                    <td>@(item.Surname ?? "-")</td>
                    <td>@(item.Age)</td>
                    <td>@(item.Gender ?? "-")</td>
                    <td>@(item.UserType.ToString() ?? "-")</td>
                    <td>@(item.status.ToString() ?? "-")</td>
                    <td>
                        <button class="btn btn-sm btn-primary me-2">Edit</button>
						@if (item.status == MOH.Models.Enum.Status.Inactive)
						{
                            <a asp-controller="Admin" asp-action="ActivateUser" asp-route-id="@item.UserId" class="btn btn-sm btn-success me-2">Activate</a>
						}
						else
						{
                            <a asp-controller="Admin" asp-action="ActivateUser" asp-route-id="@item.UserId" class="btn btn-sm btn-secondary me-2">Deactive</a>
						}
                        <a asp-controller="Admin" asp-action="DeleteUser" asp-route-id="@item.UserId" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>